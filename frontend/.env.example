# Local development
# Keep browser requests same-origin so Next proxies /api/v1 to the backend and avoids CORS.
# Only set NEXT_PUBLIC_API_BASE_URL when the target API explicitly allows this frontend origin.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

# Next.js server-side API proxy target
API_PROXY_ORIGIN=http://localhost:5000
NEXT_PUBLIC_CAREERS_CONTACT_EMAIL=careers@pravarontechnologies.com

# Production example
# API_PROXY_ORIGIN=http://server2careers.pravarontechnologies.com
